#!/bin/sh
# Cross C compiler / linker wrapper: zig cc targeting aarch64 Linux with a
# glibc 2.17 baseline (runs on every Raspberry Pi OS release).
#
# Incoming --target / -target flags are dropped first: the cc crate passes
# rustc-style triples (aarch64-unknown-linux-gnu) that zig cannot parse.
set -eu

# Filter loop: iterate over the original argument count only; kept args
# accumulate at the back of "$@".
total=$#
i=0
skip_next=0
while [ "$i" -lt "$total" ]; do
    a=$1
    shift
    i=$((i + 1))
    if [ "$skip_next" = 1 ]; then
        skip_next=0
        continue
    fi
    case "$a" in
    -target | --target) skip_next=1 ;;
    -target=* | --target=*) ;;
    # GNU-ld flag rustc passes by default for this target; zig's linker
    # rejects it, and the Pi 4 (Cortex-A72) is not affected by that erratum.
    -Wl,--fix-cortex-a53-843419) ;;
    # GNU-ld optimization knob lld no longer accepts (prints a warning).
    -Wl,-O1) ;;
    *) set -- "$@" "$a" ;;
    esac
done

exec zig cc -target aarch64-linux-gnu.2.17 "$@"
