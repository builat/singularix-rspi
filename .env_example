WEB_ADDR=0.0.0.0                                        # Web server addr to bind on. Could be local host. But I suggest to use `0.0.0.0`
WEB_PORT=8080                                           # Web server port.
LED_COUNT=274                                           # Number of LEDs on the strip (Arduino firmware used 274).
LED_COLOR_ORDER=brg                                     # Color byte order the strip expects: rgb, rbg, grb, gbr, brg or bgr. Firmware used brg.
LED_SPI_DEVICE=/dev/spidev0.0                           # SPI device the strip data wire is on (MOSI = GPIO 10, pin 19).
LED_SPI_SPEED_HZ=3200000                                # SPI clock: 4 x the 800 kHz WS2812 bit rate.
